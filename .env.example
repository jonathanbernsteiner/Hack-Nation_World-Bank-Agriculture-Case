# Copy to .env and fill in. Ask Jonathan for the values (never commit .env).
# Supabase project "hack-nation-farm-record": https://supabase.com/dashboard/project/tebdqlitjeycisaudvbm

SUPABASE_PROJECT_REF=tebdqlitjeycisaudvbm
SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co

# Safe in the browser (row-level security applies)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# New-style server key (sb_secret_...), same powers as service_role. Dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=

# Direct Postgres access (migrations, scripts)
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Same values for a Next.js frontend
NEXT_PUBLIC_SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio voice line for the demo call (paid account, owner Jonathan). Server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fallback route only (our twilio_line/ webhook instead of the ElevenLabs agent).
# Public https URL of the Twilio webhook service (Vercel URL, or ngrok for local tests). Twilio signs requests with it.
PUBLIC_BASE_URL=
# Where POST /calls runs, e.g. https://<vercel-app>/api/calls (or http://localhost:8001/calls locally)
CALLS_API_URL=
# Folder for call recordings (callers' voices; never committed). Default: recordings
RECORDINGS_DIR=recordings

# ElevenLabs (Creator tier, 1 month free via Hack-Nation; owner Jonathan). Server only.
# Dashboard: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The agent that answers the Twilio number (Agents > your agent > ID)
ELEVENLABS_AGENT_ID=
# Shared secret of the post-call webhook; the API checks the ElevenLabs-Signature header with it
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic (Claude), OPTIONAL. The ElevenLabs agent already uses Claude as its LLM through the ElevenLabs key
# (pick it in the agent's LLM setting), so no key is needed for the call. Only fill this in if our API calls
# Claude directly, e.g. the disease matcher (#29). Owner Jonathan. Server only. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hotline app (hotline/, deployed on Vercel). Names only; ask Jonathan for the values.
# On Vercel, DATABASE_URL uses the Supabase transaction pooler (port 6543); local scripts use the session pooler (5432).
ANTHROPIC_TRANSLATE_MODEL=
ANTHROPIC_EXTRACT_MODEL=
# Model the ElevenLabs agent uses (synced by scripts/sync_agent.py)
ELEVENLABS_AGENT_LLM=
# Workspace post-call webhook id
ELEVENLABS_WEBHOOK_ID=
# Header X-Hotline-Tool-Secret on /api/tools/*
HOTLINE_TOOL_SECRET=
# Header X-Hotline-Admin-Secret on /api/jobs/* and /api/health?deep=1
HOTLINE_ADMIN_SECRET=
# Basic auth for /demo
DEMO_USER=
DEMO_PASSWORD=
# Must be identical everywhere (Vercel, loaders). pins.py fails closed if unset.
LEDGER_PIN_SALT=
# Default true
PRICE_INCLUDE_SYNTHETIC=
