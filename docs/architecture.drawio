      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Voice farm record: system overview&lt;/b&gt;&lt;br&gt;Draft from the team brainstorm, 3 Oct 2026 (21:53 UTC)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="noor" value="&lt;b&gt;Noor, smallholder coffee farmer&lt;/b&gt;&lt;br&gt;basic or borrowed phone, own PIN&lt;br&gt;one call each evening, in her language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="twilio" value="&lt;b&gt;Demo: Twilio number (cloud)&lt;/b&gt;&lt;br&gt;webhook asks for the PIN, records the call, sends the audio to the laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="gsm" value="&lt;b&gt;Real world: SIM card + GSM modem&lt;/b&gt;&lt;br&gt;local number, no internet needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="190" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="box" value="Cooperative box: runs offline at the co-op office (demo: a laptop)" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f7faff;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1240" height="560" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Voice agent (the call)&lt;/b&gt;&lt;br&gt;PIN → &quot;what happened today?&quot; → gap questions → advice → her questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box">
          <mxGeometry x="40" y="60" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="stt" value="&lt;b&gt;Speech-to-text&lt;/b&gt;&lt;br&gt;open-source model for the local language (e.g. Meta MMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box">
          <mxGeometry x="360" y="60" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="extract" value="&lt;b&gt;Extraction (small local LLM)&lt;/b&gt;&lt;br&gt;fixed fields: date, plot, activities, yield, sale price, buyer, payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box">
          <mxGeometry x="680" y="60" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="review" value="&lt;b&gt;Review queue&lt;/b&gt;&lt;br&gt;records the AI may have got wrong go to a person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="box">
