<mxfile host="drawio" version="26.0.0"><diagram id="overview" name="System overview"><mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Kiswahili coffee hotline for Uganda: system architecture&lt;/b&gt;&lt;br&gt;Smallholder coffee farmers call a phone number. Price (crowdsourced), coffee problems, general questions." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell>
<mxCell id="phone" value="&lt;b&gt;Farmer, basic phone&lt;/b&gt;&lt;br&gt;4-digit PIN (keypad or spoken), Kiswahili" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="twilio" value="&lt;b&gt;Twilio number +1 628 272 9173&lt;/b&gt;&lt;br&gt;imported into ElevenLabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="g_el" value="ElevenLabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;opacity=40;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="360" height="440" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;ElevenLabs agent&lt;/b&gt;&lt;br&gt;language sw&lt;br&gt;LLM claude-sonnet-5-5 (inside ElevenLabs)&lt;br&gt;ASR Scribe, TTS eleven_v3_conversational&lt;br&gt;1 Price: PIN, village median, last sale&lt;br&gt;2 Coffee problems: tell-apart questions, fix, prevention, urgent to extension officer&lt;br&gt;3 General questions, e.g. weather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="320" height="170" as="geometry"/></mxCell>
<mxCell id="prompt" value="&lt;b&gt;System prompt&lt;/b&gt;&lt;br&gt;call flow + knowledge/coffee-problems-uganda.md + negative-only guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="postcall" value="&lt;b&gt;Post-call webhook (HMAC)&lt;/b&gt;&lt;br&gt;transcript + metadata after each call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="g_vc" value="Vercel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;opacity=40;arcSize=3;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="700" height="960" as="geometry"/></mxCell>
<mxCell id="tools" value="&lt;b&gt;hotline/ (Python FastAPI): 4 webhook tools&lt;/b&gt;&lt;br&gt;identify_farmer(pin) | find_farmer_by_location | register_farmer | get_weather_forecast&lt;br&gt;Price = village median, fallback parish &gt; sub-county &gt; district &gt; national reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="660" height="120" as="geometry"/></mxCell>
<mxCell id="apicalls" value="&lt;b&gt;POST /api/calls&lt;/b&gt;&lt;br&gt;verifies HMAC, stores call (status received)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="pending" value="&lt;b&gt;GET /api/jobs/process-pending&lt;/b&gt;&lt;br&gt;safety-net trigger for unprocessed calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="320" height="70" as="geometry"/></mxCell>
