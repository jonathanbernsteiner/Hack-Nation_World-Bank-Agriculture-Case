# Copy to .env and fill in. Ask Jonathan for the values (never commit .env).
# Supabase project "hack-nation-farm-record": https://supabase.com/dashboard/project/tebdqlitjeycisaudvbm

SUPABASE_PROJECT_REF=tebdqlitjeycisaudvbm
SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co

# Safe in the browser (row-level security applies)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres access (migrations, scripts)
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Same values for a Next.js frontend
NEXT_PUBLIC_SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio voice line for the demo call (trial account, owner Jonathan). Server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fallback route only (our twilio_line/ webhook instead of the ElevenLabs agent).
# Public https URL of the Twilio webhook service (Vercel URL, or ngrok for local tests). Twilio signs requests with it.
PUBLIC_BASE_URL=
# Where POST /calls runs, e.g. https://<vercel-app>/api/calls (or http://localhost:8001/calls locally)
CALLS_API_URL=
# Folder for call recordings (callers' voices; never committed). Default: recordings
RECORDINGS_DIR=recordings

# ElevenLabs (Creator tier, 1 month free via Hack-Nation; owner Jonathan). Server only.
# Dashboard: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The agent that answers the Twilio number (Agents > your agent > ID)
ELEVENLABS_AGENT_ID=
# Shared secret of the post-call webhook; the API checks the ElevenLabs-Signature header with it
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic (Claude): the second model, e.g. extraction and disease matching (owner Jonathan). Server only.
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
