# Copy to .env and fill in. Ask Jonathan for the values (never commit .env).
# Supabase project "hack-nation-farm-record": https://supabase.com/dashboard/project/tebdqlitjeycisaudvbm

SUPABASE_PROJECT_REF=tebdqlitjeycisaudvbm
SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co

# Safe in the browser (row-level security applies)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres access (migrations, scripts)
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Same values for a Next.js frontend
NEXT_PUBLIC_SUPABASE_URL=https://tebdqlitjeycisaudvbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio voice line for the demo call (trial account, owner Jonathan). Server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public https URL of the Twilio webhook service (the ngrok URL). Twilio signs requests with it.
PUBLIC_BASE_URL=
# Where the laptop's POST /calls (#11) runs, e.g. http://localhost:8001/calls
CALLS_API_URL=
# Folder for call recordings (callers' voices; never committed). Default: recordings
RECORDINGS_DIR=recordings
